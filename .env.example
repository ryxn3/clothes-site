# This site is a static export (GitHub Pages compatible), so checkout is
# handled via a hosted Stripe Payment Link rather than a server API route.
# Create one at https://dashboard.stripe.com/payment-links and paste its URL
# below to enable the "Checkout Securely" button.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link

# Full public URL the site will be deployed to (used for canonical links,
# Open Graph tags, robots.txt, and sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
